  "font_size_rules": {
    "regulation": "legal_metrology",
    "rule_id": "LM_PCR_R7",
    "rule_reference": "Rule 7",
    "description": "Minimum letter/numeral height for declarations on the Principal Display Panel (PDP). Letters: not less than 1mm in any case. Numerals for weight/volume follow Table I, banded by PDP area; width of any letter/numeral must be >= 1/3 of its height (except '1', 'i', 'I', 'l').",
    "min_letter_height_mm": 1.0,
    "numeral_height_by_pdp_area_mm": [
      {"max_area_cm2": 100, "min_numeral_height_mm": 2},
      {"max_area_cm2": 500, "min_numeral_height_mm": 4},
      {"max_area_cm2": null, "min_numeral_height_mm": 6}
    ],
    "min_stroke_width_ratio": 0.333
  },
