{
  "_meta": {
    "source": "Legal Metrology (Packaged Commodities) Rules, 2011 (as amended); Food Safety and Standards (Labelling and Display) Regulations, 2020; Plastic Waste Management Rules, 2016 (as amended, incl. the Jan 2025 Rule 11(1A) marking/labelling amendment)",
    "disclaimer": "This file is a DEVELOPMENT SEED for the validation engine, not a certified legal reference. Before any production/enforcement use, have a domain expert in each regulation verify every threshold below against the current Gazette-notified text and any state-level amendments, and update accordingly. Regulations referenced here (especially Plastic Waste Management EPR rules) are actively being amended year over year -- re-verify before relying on any specific figure.",
    "last_reviewed": "2026-09-03"
  },
  "regulations": {
    "legal_metrology": {
      "name": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "applicability": "always",
      "description": "Baseline declarations required on every pre-packaged commodity sold in India, regardless of category."
    },
    "fssai_labelling": {
      "name": "Food Safety and Standards (Labelling and Display) Regulations, 2020",
      "applicability": "food",
      "description": "Additional declarations required specifically for pre-packaged food products, on top of (not instead of) Legal Metrology's net quantity/MRP/consumer-care requirements, which FSSAI's own regulation explicitly cross-references rather than duplicates."
    },
    "plastic_waste_management": {
      "name": "Plastic Waste Management Rules, 2016, as amended (Rule 11(1A) marking & labelling requirements, EPR)",
      "applicability": "plastic_packaging",
      "description": "Marking requirements for plastic packaging material itself (distinct from the product inside it) -- material identification, recycled-content/compostability claims, and EPR traceability."
    }
  },
