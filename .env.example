# ============================================================================
# Legal Metrology Compliance Engine — environment configuration
# Copy this file to backend/.env (and frontend/.env.local, see below) and
# fill in real values. Sensible local-dev defaults are used for anything
# left blank, so you can run the whole stack with zero cloud credentials.
# ============================================================================

# ---------------------------------------------------------------------------
# BACKEND — copy the block below into backend/.env
# ---------------------------------------------------------------------------

# General
ENV=development

# Security — CHANGE THIS before any shared/staging/production deployment
JWT_SECRET_KEY=change_me_to_a_long_random_string

# Database
# Local dev default (no setup required):
DATABASE_URL=sqlite:///./legal_metrology.db
# Production (Postgres) example:
# DATABASE_URL=postgresql://lm_user:lm_password@localhost:5432/legal_metrology

# File storage: "local" (default, zero setup) or "s3"
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
# Required only if STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# OCR engine: "tesseract" (default, fully offline) | "gcv" | "textract"
OCR_ENGINE=tesseract
# Required only if OCR_ENGINE=gcv
GOOGLE_APPLICATION_CREDENTIALS=

# Metrology Bot (RAG legal assistant) -- "gemini" (default) or "anthropic"
CHATBOT_PROVIDER=gemini

# Required if CHATBOT_PROVIDER=gemini. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Required if CHATBOT_PROVIDER=anthropic. Omit to fall back to raw
# rule-corpus lookup without LLM reasoning.
ANTHROPIC_API_KEY=
CHATBOT_MODEL=claude-sonnet-4-6

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=["http://localhost:3000"]

# ---------------------------------------------------------------------------
# FRONTEND — copy the block below into frontend/.env.local
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend (used by next.config.js rewrites)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
